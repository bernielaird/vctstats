# Copy this file to .env (which git ignores) and fill in your own values.

# Sent to vlr.gg in the User-Agent so they can contact whoever is running the scraper.
VCT_CONTACT_EMAIL=you@example.com

# Website updates (update_site.ps1 / model/publish_site.py). Optional; only needed to publish.
# Fine-grained GitHub token: this repo only, Contents read and write.
GITHUB_TOKEN=
# Render > your web service > Settings > Deploy Hook. Leave empty to upload without redeploying.
RENDER_DEPLOY_HOOK=
